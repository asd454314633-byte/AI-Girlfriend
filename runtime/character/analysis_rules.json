{
  "_说明": "小说人物分析的词表与阈值（任务 §11）。分析器只做「按这份表去原文里找证据 + 做统计」，不猜没有证据的东西；表里没有的维度会如实报『书里没写到』。",
  "_为什么是数据不是代码": "换一本书、想加一类线索，改这里就行，不用动 Python，也不用碰任何模型。",

  "max_sentences_per_dimension": 3,
  "evidence_max_chars": 90,
  "min_evidence_chars": 8,
  "max_entries_per_dimension": 4,

  "quote_brackets": [["“", "”"], ["「", "」"], ["『", "』"], ["\"", "\""]],
  "speech_verbs": ["说", "道", "问", "答", "笑", "低声", "开口", "喊", "嘟囔", "念", "应", "斥", "叹"],
  "addressee_patterns": ["(对|向|朝|看着|望向|盯着)([\\u4e00-\\u9fff]{2,4})(说|道|问|答|念)"],
  "_pronoun_aliases_说明": "中文小说多半用代称写她，只认本名会漏掉一大半台词和性格线索。这些代称只用来「认定这句话是在说她」，结论照样要带原句出处。",
  "pronoun_aliases": ["她", "他"],

  "dimensions": {
    "identity": {
      "patterns": ["{name}(是|身为|作为|当了|做了|就是)", "((人称|外号|都叫她|自称)){1}.{0,12}", "(守灯人|灯守|船工|掌柜|东家|老人|少爷|小姐|丫鬟|先生|大夫|队长|站长)"],
      "kind": "setting", "weight": 160, "confidence": 0.95, "basis": "canon"
    },
    "background": {
      "patterns": ["(从小|小时候|出生|故里|老家|家里|爹|娘|父亲|母亲|长大|孤身|无亲)(.{0,20})"],
      "name_must_appear": true,
      "kind": "setting", "weight": 140, "confidence": 0.9, "basis": "canon"
    },
    "relationship": {
      "patterns": ["(妻子|丈夫|夫君|娘子|女儿|儿子|父亲|母亲|师兄|师妹|师姐|弟弟|妹妹|姐姐|哥哥|朋友|旧识|恩人|仇人|主子|丫头|同门|搭档|未婚)"],
      "name_must_appear": true,
      "kind": "relationship", "weight": 150, "confidence": 0.92, "basis": "canon"
    },
    "experience": {
      "patterns": ["(救|死|离开|回来|发现|答应|拒绝|失去|烧|塌|沉|找了三|守了|等了三|没能|已经不再)"],
      "name_must_appear": true,
